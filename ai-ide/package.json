{
  "name": "ai-ide",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:electron",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "vite",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "build:electron": "cd electron && npx tsc main.ts preload.ts --target ESNext --module CommonJS --esModuleInterop --skipLibCheck --outDir . --ignoreConfig",
    "dev:full": "concurrently -k \"npm start\" \"wait-on tcp:5173 && npm run dev:electron\""
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "autoprefixer": "^10.6.1",
    "chokidar": "^4.0.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.56.0",
    "node-pty": "^1.1.0",
    "openai": "^7.32.0",
    "postcss": "^8.5.30",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^3.4.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wait-on": "^9.5.1"
  }
}
